<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Optional, legacy-compatible Microsoft MSAGL layout provider for Mermaider. The built-in layout engine is faster and supports compound subgraph layout and orthogonal routing; use this package to keep output from earlier versions.</Description>
    <NoWarn>CS1591</NoWarn>
    <PackageTags>mermaid;layout;msagl;graph;optional</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\nuget-icon.png" Pack="true" PackagePath="nuget-icon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mermaider/Mermaider.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Msagl" />
  </ItemGroup>
</Project>
