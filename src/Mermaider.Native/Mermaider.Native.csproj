<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- A native shared library, not a package: one TargetFramework, published ahead of time per runtime identifier
         (`dotnet publish -r osx-arm64 -c Release`). The assembly is Mermaider.Native (not `mermaider`: assembly names are
         compared without case, and the library's other assembly is Mermaider); publishing also names the library mermaider.* -->
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mermaider.Native</RootNamespace>
    <Description>Mermaider as a native library with a C ABI: Mermaid text in, SVG out, for any language with a C FFI.</Description>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StripSymbols>true</StripSymbols>
    <OptimizationPreference>Size</OptimizationPreference>
    <StackTraceSupport>false</StackTraceSupport>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mermaider.Native.Tests" PublicKey="" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Mermaider/Mermaider.csproj" />
  </ItemGroup>
  <!-- The published library under the name hosts look for: mermaider.dylib, mermaider.so or mermaider.dll. -->
  <Target Name="NameNativeLibrary" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <PropertyGroup>
      <NativeExtension Condition="$(RuntimeIdentifier.StartsWith('osx'))">dylib</NativeExtension>
      <NativeExtension Condition="$(RuntimeIdentifier.StartsWith('linux'))">so</NativeExtension>
      <NativeExtension Condition="$(RuntimeIdentifier.StartsWith('win'))">dll</NativeExtension>
    </PropertyGroup>
    <Copy SourceFiles="$(PublishDir)Mermaider.Native.$(NativeExtension)" DestinationFiles="$(PublishDir)mermaider.$(NativeExtension)" />
  </Target>
</Project>
