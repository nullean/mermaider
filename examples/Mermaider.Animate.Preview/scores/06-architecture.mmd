architecture-beta
  %% architecture-beta: build it up, then follow a request through the groups and back
  group edge(cloud)[Edge]
  group app(server)[App]
  service lb(internet)[Balancer] in edge
  service api(server)[API] in app
  service db(database)[DB] in app
  lb:R --> L:api
  api:R --> L:db

animate
  build
  step "A request enters at the edge and reaches the database"
    tour lb -> api -> db "GET /orders"
  step "The answer travels back the same way"
    tour db -> api -> lb "200 OK" as ok
