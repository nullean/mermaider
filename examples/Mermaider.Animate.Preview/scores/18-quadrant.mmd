quadrantChart
  %% Quadrant: features land on the chart, then the one worth doing first is called out
  title Effort and impact
  x-axis Low effort --> High effort
  y-axis Low impact --> High impact
  quadrant-1 Plan
  quadrant-2 Do first
  quadrant-3 Skip
  quadrant-4 Avoid
  Search: [0.25, 0.85]
  Dark mode: [0.2, 0.3]
  Rewrite: [0.85, 0.75]
  Export: [0.7, 0.2]

animate
  build
  step "Search is cheap and matters most"
    focus "Search"
    badge "Search" "do first" as ok
