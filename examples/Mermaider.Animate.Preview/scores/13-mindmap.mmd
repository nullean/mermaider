mindmap
  %% Mindmap: a platform's areas branch out, then one area opens up
  root((Platform))
    Frontend
      Web
      Mobile
    Backend
      API
      Workers
      Storage
    Operations
      CI
      Monitoring

animate
  step "The platform has three areas"
    expand "Platform"
  step "The backend is where the work is"
    focus "Backend"
    pulse "API", "Workers", "Storage" each
