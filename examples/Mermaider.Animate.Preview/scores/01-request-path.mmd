flowchart LR
  %% Architecture: a request walks the path, a node fails, the balancer fails over
  client[Client] --> lb[Balancer]
  lb --> api1[API 1]
  lb --> api2[API 2]
  api1 --> db[(Database)]
  api2 --> db

animate
  build
  step "A request takes the usual path"
    tour client -> lb -> api1 -> db "GET /orders"
  step "API 1 stops answering"
    mark api1 fail
    cut lb -> api1
  step "The balancer fails over to API 2"
    send lb -> api2 "GET /orders" as ok
    send api2 -> db
  step "Back to normal"
    restore lb -> api1
    mark api1 clear
